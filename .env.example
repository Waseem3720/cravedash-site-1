# Copy to .env and fill in the values from the backend team.

# Public API gateway, including the /api/v1 prefix.
VITE_API_BASE_URL=https://cravedash.keydevs.net/api/v1

# Storefront API key (sent as X-API-KEY on public catalogue/config calls).
VITE_API_KEY=

# Tenant id for this restaurant (sent as X-Restaurant-Id).
VITE_RESTAURANT_ID=

# Host port for Docker Compose (optional, default: 8081)
PORT=8081

